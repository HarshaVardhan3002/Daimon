{
  "expo": {
    "name": "Daimon",
    "slug": "assistant-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "assistant",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sharing",
      "./plugins/withLoopbackProxyCleartext",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Daimon to use the camera to attach a photo.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Allow Daimon to save generated images to your photo library.",
          "granularPermissions": ["photo"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.anonymous.assistantmobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
